  "agentRun": {
    "recordVersion": 4,
    "eventEnvelopeFields": [
      "protocolVersion",
      "seq",
      "type",
      "data",
      "createdAt"
    ],
    "statuses": [
      {
        "name": "model",
        "class": "active",
        "meaning": "The worker is preparing, starting, or waiting for a model round."
      },
      {
        "name": "tools",
        "class": "active",
        "meaning": "The worker is executing or resuming pending tool calls."
      },
      {
        "name": "waiting_credentials",
        "class": "waiting",
        "meaning": "Credentials were intentionally dropped and the run needs a resume request; restored active runs also normalize to this status."
      },
      {
        "name": "waiting_user_input",
        "class": "waiting",
        "meaning": "A normalized questionnaire or empty-response continuation is pending."
      },
      {
        "name": "waiting_authorization",
        "class": "waiting",
        "meaning": "A command, edit, file mutation, or child authorization decision is pending."
      },
      {
        "name": "completed",
        "class": "terminal",
        "meaning": "The run produced a final result."
      },
      {
        "name": "failed",
        "class": "terminal",
        "meaning": "The run ended with an error and optional error code."
      },
      {
        "name": "cancelled",
        "class": "terminal",
        "meaning": "Cancellation reached the AgentRun terminal boundary."
      }
    ],
    "events": [
