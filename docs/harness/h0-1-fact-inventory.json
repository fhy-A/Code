  "sanitizedTraceCandidates": [
    {
      "id": "plain-text-final",
      "scenario": "One model round returns a final text answer."
    },
    {
      "id": "single-read-tool",
      "scenario": "A model round requests one read-only tool, then returns a final answer."
    },
    {
      "id": "multi-tool-stage",
      "scenario": "One stage contains multiple read-only tool calls and preserves active versus completed group titles."
    },
    {
      "id": "questionnaire-submit",
      "scenario": "request_user_input pauses the run, accepts answers, resumes credentials, and completes."
    },
    {
      "id": "edit-authorization-accept",
      "scenario": "An edit proposal waits for authorization, is accepted, and completes once."
    },
    {
      "id": "command-authorization-reject",
      "scenario": "A command waits for authorization, is rejected, and returns a deterministic tool result."
    },
    {
      "id": "auto-compaction-success",
      "scenario": "Threshold compaction emits start and completion markers before the model continues."
    },
    {
      "id": "auto-compaction-failure",
      "scenario": "Compaction failure is projected but the surrounding run state remains diagnosable."
    },
    {
      "id": "cancel-during-model",
      "scenario": "Cancellation interrupts an active model runtime and produces one terminal cancellation."
    },
    {
      "id": "cancel-during-command",
      "scenario": "Cancellation interrupts a command and does not replay it."
    },
    {
      "id": "refresh-before-first-response",
      "scenario": "A refresh restores an active server-owned run without duplicating the upstream model request."
    },
    {
      "id": "refresh-during-tools",
      "scenario": "A refresh restores the event cursor and does not duplicate an already completed tool."
    },
    {
      "id": "server-restart-command-unknown",
      "scenario": "A command active during server restart becomes an unknown-state non-replayed result."
    },
    {
      "id": "poll-disconnect-reconnect",
      "scenario": "Agent polling disconnects, shows recovery state, resumes from the last successful event cursor, and completes."
    },
    {
      "id": "model-non-action-recovery",
      "scenario": "An empty or reasoning-only model response triggers one recovery round before completion or failure."
    }
  ]
